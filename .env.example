# Optional. Configure a Lichess personal API access token for Opening Explorer.
# Keep the real value in .env.local; never commit secrets.
LICHESS_API_TOKEN=
# Required to enable private-app authentication. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_USERNAME=
# Generate locally: GMB_SETUP_PASSWORD='your-long-password' node scripts/hash-password.mjs
AUTH_PASSWORD_HASH=

# Select PostgreSQL at build time. Local development defaults to SQLite.
# GMB_DB_PROVIDER=postgresql
# DATABASE_URL=postgresql://...-pooler.../dbname?sslmode=require&pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://.../dbname?sslmode=require
# GMB_TRANSFER_POSTGRES_URL=  # local transfer command only; never needed by app runtime

# Local default is private. Hosted deployments require an explicit mode.
# GMB_SITE_MODE=public
